# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง:  cp .env.example .env
# ค่า default ข้างล่างตรงกับ docker-compose.yml ใช้ได้เลยตอน dev
DATABASE_URL="postgresql://joblab:joblab@localhost:5433/joblab?schema=public"

# กุญแจที่ Auth.js ใช้เซ็น session cookie — สร้างค่าใหม่ของตัวเองด้วย:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
