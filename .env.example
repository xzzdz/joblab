# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง:  cp .env.example .env
# ค่า default ข้างล่างตรงกับ docker-compose.yml ใช้ได้เลยตอน dev

# ── จำเป็น ──────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://joblab:joblab@localhost:5433/joblab?schema=public"

# กุญแจที่ Auth.js ใช้เซ็น session cookie — สร้างค่าใหม่ของตัวเองด้วย:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# ── ไม่จำเป็น (ไม่ใส่ก็ใช้งานได้ ฟีเจอร์ที่เกี่ยวข้องจะปิดไว้เอง) ─────────────────

# ล็อกอินด้วย Google — ขอได้ที่ https://console.cloud.google.com/apis/credentials
#   สร้าง OAuth client ID แบบ "Web application"
#   Authorized redirect URI ตอน dev:  http://localhost:3000/api/auth/callback/google
#   Authorized redirect URI ตอน prod: https://<โดเมนของคุณ>/api/auth/callback/google
# ถ้าไม่ใส่สองค่านี้ ปุ่ม "เข้าสู่ระบบด้วย Google" จะไม่แสดง
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ส่งอีเมล (ใช้กับฟีเจอร์ลืมรหัสผ่าน) — ขอ key ได้ที่ https://resend.com
# ถ้าไม่ใส่ ลิงก์ตั้งรหัสผ่านใหม่จะถูกพิมพ์ออกที่ terminal แทนการส่งอีเมลจริง
# ซึ่งใช้ทดสอบบนเครื่องตัวเองได้เลย
RESEND_API_KEY=""
EMAIL_FROM="JobLab <onboarding@resend.dev>"

# URL ของเว็บ ใช้ประกอบลิงก์ในอีเมลและ sitemap
# ตอน dev ไม่ต้องใส่ (ค่า default คือโดเมน production)
NEXT_PUBLIC_SITE_URL=""
