// Prisma schema — "แหล่งความจริงเดียว" ของโครงสร้างฐานข้อมูล
// แก้ไฟล์นี้ทีไร ต้องรัน `npm run db:migrate` เพื่อสร้าง SQL migration + generate client ใหม่เสมอ
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums — Postgres รองรับ enum จริง ทำให้ DB ปฏิเสธค่าที่ไม่ถูกต้องตั้งแต่ชั้น DB
// ไม่ใช่แค่เช็คในโค้ด
// ---------------------------------------------------------------------------

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum JobStatus {
  DRAFT // บริษัทยังเขียนไม่เสร็จ ยังไม่มีใครเห็น
  PUBLISHED // ประกาศอยู่ ผู้สมัครเห็นได้
  CLOSED // ปิดรับแล้ว แต่ยังเก็บข้อมูลไว้
}

enum UserRole {
  SEEKER // ผู้สมัครงาน
  EMPLOYER // บริษัท/ผู้ลงประกาศ
}

/// ขั้นตอนของใบสมัคร เรียงตามลำดับที่เกิดจริงในกระบวนการคัดเลือก
/// ลำดับที่ประกาศตรงนี้มีผลกับการเรียงคอลัมน์บนบอร์ด (ดู APPLICATION_STATUS_ORDER)
enum ApplicationStatus {
  APPLIED // ส่งใบสมัครแล้ว รอบริษัทดู
  SCREENING // บริษัทกำลังพิจารณา
  INTERVIEW // นัดสัมภาษณ์
  OFFER // ยื่นข้อเสนอแล้ว
  REJECTED // บริษัทปฏิเสธ
  WITHDRAWN // ผู้สมัครถอนใบสมัครเอง
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String

  // เก็บ "ค่าแฮช" ของรหัสผ่านเท่านั้น ไม่เคยเก็บรหัสผ่านจริง
  // ถ้าฐานข้อมูลหลุด คนได้ไฟล์ไปก็ยังเอารหัสผ่านคืนไม่ได้
  passwordHash String?

  role UserRole @default(SEEKER)

  // ผู้ใช้ที่เป็น EMPLOYER จะผูกกับบริษัท 1 แห่ง (1-to-1)
  company Company?

  // ใบสมัครที่ผู้ใช้คนนี้ส่งไป (เฉพาะ role SEEKER ที่จะมีข้อมูลตรงนี้)
  applications Application[]

  /// งานที่กดบันทึกไว้ดูภายหลัง
  savedJobs SavedJob[]

  /// คำขอตั้งรหัสผ่านใหม่
  passwordResets PasswordReset[]

  /**
   * บัญชีจากผู้ให้บริการภายนอก (Google ฯลฯ)
   *
   * ทำไมต้องแยกตาราง ไม่ใส่ `googleId` ลงใน User เลย:
   * ผู้ใช้คนเดียวอาจผูกได้หลายบริการ (Google + GitHub + ...) ถ้าใส่เป็นคอลัมน์
   * ทุกครั้งที่รองรับบริการใหม่ต้องเพิ่มคอลัมน์ใหม่และแก้ทุก query ที่เกี่ยวข้อง
   */
  oauthAccounts OAuthAccount[]

  /**
   * ผู้ใช้ที่สมัครด้วย Google ไม่มีรหัสผ่าน จึงต้องให้ null ได้
   *
   * ⚠️ ผลที่ตามมาซึ่งต้องระวัง: ตอนล็อกอินด้วยรหัสผ่าน ถ้าเจอผู้ใช้ที่ passwordHash เป็น null
   * ต้องปฏิเสธ **ห้ามเทียบกับค่า null แล้วผ่าน** ไม่งั้นใครรู้อีเมลของคนที่สมัครผ่าน Google
   * ก็ล็อกอินเข้าบัญชีนั้นได้โดยไม่ต้องใส่รหัสผ่านเลย
   */

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id          String  @id @default(cuid())
  slug        String  @unique // ใช้ทำ URL สวย ๆ เช่น /companies/acme-tech
  name        String
  logoUrl     String?
  website     String?
  description String?

  // ฝั่งที่ถือ foreign key ของความสัมพันธ์ 1-to-1 กับ User
  //
  // **ตอนนี้เป็น required แล้ว — และการมาถึงจุดนี้ใช้ 3 ขั้น**
  //
  // ขั้น 1 (Phase 2): เพิ่มเป็น optional (`String?`)
  //   เพราะตอนนั้นตารางมีข้อมูล seed อยู่แล้ว 5 แถว ถ้าประกาศ required ทันที
  //   Postgres จะเติมค่าให้แถวเดิมไม่ได้ → migration ล้ม ต้องล้าง DB ทิ้งเท่านั้น
  //   ซึ่งบน production ทำไม่ได้
  // ขั้น 2 (Phase 2): backfill — ให้ seed ใส่เจ้าของให้ทุกบริษัทที่มีอยู่
  // ขั้น 3 (ตอนนี้): ตรวจว่าไม่มีแถวไหนเป็น NULL แล้ว (`count(*) FILTER (WHERE "ownerId" IS NULL)` = 0)
  //   จึงบังคับเป็น required ได้อย่างปลอดภัย
  //
  // ทำไมต้องบังคับ: บริษัทที่ไม่มีเจ้าของคือข้อมูลที่ไม่มีใครแก้ได้เลย
  // ทุก query ฝั่งจัดการใช้ `ownerId` เป็นเงื่อนไขสิทธิ์ — แถวที่เป็น NULL จะหลุดจากทุกเงื่อนไข
  // กลายเป็นข้อมูลกำพร้าที่ลบก็ไม่ได้ แก้ก็ไม่ได้
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  jobs Job[] // ความสัมพันธ์ 1-to-many: 1 บริษัท มีได้หลายงาน

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Index สำหรับค้นหาชื่อบริษัท (ILIKE '%คำค้น%')
  /// เหตุผลเดียวกับ index ของ Job.title — ดูคำอธิบายที่นั่น
  /// ตอนนี้มี 5 บริษัทจึงยังไม่เห็นผล แต่ query ค้นหาแตะตารางนี้ทุกครั้ง
  /// ใส่ไว้ตอนที่ยังเล็กง่ายกว่ามารู้ตัวตอนช้าแล้ว
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Job {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String

  location String
  workMode WorkMode @default(ONSITE)
  type     JobType  @default(FULL_TIME)

  // เก็บเงินเดือนเป็น Int (บาท/เดือน) และให้ null ได้ เพราะบางประกาศไม่ระบุ
  salaryMin Int?
  salaryMax Int?

  status      JobStatus @default(DRAFT)
  publishedAt DateTime?

  // ฝั่ง "many" ของความสัมพันธ์ — เก็บ foreign key ไว้ที่นี่
  // onDelete: Cascade = ถ้าบริษัทถูกลบ งานของบริษัทนั้นถูกลบตามอัตโนมัติโดย DB
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  applications Application[]

  /// ผู้ใช้ที่กดบันทึกงานนี้ไว้
  savedBy SavedJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Index ตามรูปแบบ query ที่ใช้จริง: หน้า list กรอง status แล้วเรียงตาม publishedAt
  @@index([status, publishedAt])
  @@index([companyId])

  /**
   * Index สำหรับการค้นหาด้วยคำ (ILIKE '%คำค้น%')
   *
   * ทำไมต้องเป็น GIN + gin_trgm_ops ไม่ใช่ index ธรรมดา:
   * index แบบ B-tree เรียงข้อมูลจากตัวอักษรตัวแรก จึงใช้ได้กับ 'คำขึ้นต้น%' เท่านั้น
   * พอค้นแบบ '%กลางคำ%' Postgres ใช้ไม่ได้เลย ต้องไล่อ่านทุกแถว (Seq Scan)
   *
   * gin_trgm_ops หั่นข้อความเป็นชุดตัวอักษรทีละ 3 ตัว (trigram) แล้วทำ index จากชิ้นส่วนพวกนั้น
   * ทำให้ค้นกลางคำได้ วัดจริงบนข้อมูล 50,000 แถว: 26.6 ms → 0.4 ms
   *
   * ต้องเปิด extension pg_trgm ก่อนใช้ ซึ่งเขียนไว้ในไฟล์ migration แล้ว
   */
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Application {
  id String @id @default(cuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  seekerId String
  seeker   User   @relation(fields: [seekerId], references: [id], onDelete: Cascade)

  coverLetter String?

  /// ชื่อไฟล์ที่ผู้ใช้อัปโหลดมา ใช้แสดงผลและตั้งชื่อตอนดาวน์โหลดเท่านั้น
  /// ไม่เคยถูกเอาไปใช้เป็นชื่อไฟล์จริงหรือต่อเป็น path
  resumeName String

  /// ตัวไฟล์อยู่คนละตารางโดยตั้งใจ (ดูคำอธิบายที่ model ResumeFile)
  resume ResumeFile?

  status ApplicationStatus @default(APPLIED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// กันสมัครงานเดิมซ้ำ — บังคับที่ระดับฐานข้อมูล ไม่ใช่แค่เช็คในโค้ด
  /// เพราะการเช็คในโค้ดปิดช่อง race condition ไม่ได้ (กดปุ่มรัว ๆ สองที่พร้อมกัน)
  @@unique([jobId, seekerId])

  /// หน้า "ใบสมัครของฉัน" — กรองด้วย seekerId แล้วเรียงตามวันที่สมัคร
  @@index([seekerId, createdAt])

  /// บอร์ดของบริษัท — กรองด้วย jobId แล้วแยกตามสถานะ
  @@index([jobId, status])
}

/// ไฟล์ resume ที่เก็บเป็นข้อมูลไบนารีในฐานข้อมูล
///
/// **ทำไมย้ายจากดิสก์มาเก็บใน DB:**
/// Phase 5 เก็บไฟล์ลงโฟลเดอร์ `.uploads/` ซึ่งใช้ได้แค่ตอน dev
/// เพราะ Vercel รันบน serverless ที่ filesystem หายทุกครั้งที่ deploy และไม่แชร์กันระหว่าง instance
/// ผลคือผู้ใช้อัปโหลด resume วันนี้ พรุ่งนี้ deploy ใหม่ ไฟล์หายหมด
///
/// **ทำไมแยกตารางแทนที่จะใส่ฟิลด์ Bytes ใน Application เลย:**
/// ถ้าใส่ไว้ในตารางเดียวกัน วันหนึ่งจะมีคนเขียน `findMany` โดยไม่ใส่ `select`
/// แล้วลากไฟล์หลายเมกะไบต์ออกมาทั้งตารางโดยไม่รู้ตัว
/// แยกตารางทำให้ต้องตั้งใจ join ถึงจะได้ไฟล์ — เผลอไม่ได้
///
/// **ข้อจำกัดที่ต้องรู้:** วิธีนี้เหมาะกับไฟล์เล็ก (เราจำกัดไว้ 2 MB) และจำนวนไม่มาก
/// ถ้าโตขึ้นจริงต้องย้ายไป object storage เพราะ (1) ขนาด DB จะบวมและ backup ช้า
/// (2) การอ่านไฟล์ทุกครั้งกิน connection ของ DB ซึ่งเป็นทรัพยากรที่มีจำกัดที่สุด
/// ตอนนั้นแก้แค่ `src/lib/storage.ts` ไฟล์เดียว
model ResumeFile {
  id String @id @default(cuid())

  /// ผูกกับใบสมัครแบบ 1-1 และ Cascade
  /// ลบใบสมัคร → ไฟล์ถูกลบตามโดยฐานข้อมูลเอง ไม่ต้องเขียนโค้ดเก็บกวาด
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  data Bytes
  size Int

  createdAt DateTime @default(now())
}

/// งานที่ผู้ใช้กดบันทึกไว้ดูภายหลัง
model SavedJob {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// กันบันทึกงานเดิมซ้ำที่ระดับฐานข้อมูล
  /// สำคัญเพราะปุ่มบันทึกกดรัว ๆ ได้ การเช็คในโค้ดอย่างเดียวปิดช่อง race condition ไม่ได้
  @@unique([userId, jobId])

  /// หน้า "งานที่บันทึกไว้" กรองด้วย userId แล้วเรียงตามเวลาที่บันทึก
  @@index([userId, createdAt])
}

/**
 * บัญชีจากผู้ให้บริการภายนอก
 *
 * เก็บแค่ข้อมูลที่จำเป็นต่อการจับคู่ว่า "บัญชีของ provider นี้คือผู้ใช้คนไหนในระบบเรา"
 * ไม่เก็บ access token เพราะเราไม่ได้เรียก API ของ Google ต่อ — ใช้แค่ยืนยันตัวตนตอนล็อกอิน
 * เก็บสิ่งที่ไม่ใช้คือการเพิ่มความเสียหายฟรี ๆ ถ้าฐานข้อมูลหลุด
 */
model OAuthAccount {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// ชื่อผู้ให้บริการ เช่น "google"
  provider String

  /// id ของผู้ใช้ในระบบของผู้ให้บริการนั้น
  providerAccountId String

  createdAt DateTime @default(now())

  /// บัญชีเดียวของ provider ต้องผูกกับผู้ใช้ได้คนเดียว
  @@unique([provider, providerAccountId])
  @@index([userId])
}

/**
 * คำขอตั้งรหัสผ่านใหม่
 *
 * **เก็บเป็นค่าแฮชของ token ไม่ใช่ token จริง** — หลักการเดียวกับรหัสผ่าน
 * ถ้าฐานข้อมูลหลุด คนที่ได้ไปจะเอา token ไปใช้ตั้งรหัสผ่านใหม่ของใครก็ได้ทันที
 * เก็บแฮชไว้แทน แล้วตอนตรวจก็แฮชค่าที่ผู้ใช้ส่งมาเทียบ
 */
model PasswordReset {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 ของ token ที่ส่งไปในลิงก์
  tokenHash String @unique

  expiresAt DateTime

  /// เวลาที่ถูกใช้ไปแล้ว — ใช้ได้ครั้งเดียวเท่านั้น
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
