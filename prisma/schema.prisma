// Prisma schema — "แหล่งความจริงเดียว" ของโครงสร้างฐานข้อมูล
// แก้ไฟล์นี้ทีไร ต้องรัน `npm run db:migrate` เพื่อสร้าง SQL migration + generate client ใหม่เสมอ
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums — Postgres รองรับ enum จริง ทำให้ DB ปฏิเสธค่าที่ไม่ถูกต้องตั้งแต่ชั้น DB
// ไม่ใช่แค่เช็คในโค้ด
// ---------------------------------------------------------------------------

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum JobStatus {
  DRAFT // บริษัทยังเขียนไม่เสร็จ ยังไม่มีใครเห็น
  PUBLISHED // ประกาศอยู่ ผู้สมัครเห็นได้
  CLOSED // ปิดรับแล้ว แต่ยังเก็บข้อมูลไว้
}

enum UserRole {
  SEEKER // ผู้สมัครงาน
  EMPLOYER // บริษัท/ผู้ลงประกาศ
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String

  // เก็บ "ค่าแฮช" ของรหัสผ่านเท่านั้น ไม่เคยเก็บรหัสผ่านจริง
  // ถ้าฐานข้อมูลหลุด คนได้ไฟล์ไปก็ยังเอารหัสผ่านคืนไม่ได้
  passwordHash String

  role UserRole @default(SEEKER)

  // ผู้ใช้ที่เป็น EMPLOYER จะผูกกับบริษัท 1 แห่ง (1-to-1)
  company Company?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id          String  @id @default(cuid())
  slug        String  @unique // ใช้ทำ URL สวย ๆ เช่น /companies/acme-tech
  name        String
  logoUrl     String?
  website     String?
  description String?

  // ฝั่งที่ถือ foreign key ของความสัมพันธ์ 1-to-1 กับ User
  //
  // ทำไมเป็น optional (`?`): ตอนเพิ่มฟิลด์นี้ ตาราง Company มีข้อมูล seed อยู่แล้ว 5 แถว
  // ถ้าประกาศเป็น required ทันที Postgres จะเติมค่าให้แถวเดิมไม่ได้ → migration ล้ม
  // ต้องรีเซ็ตฐานข้อมูลทิ้งเท่านั้น ซึ่งบน production ทำไม่ได้
  //
  // วิธีมาตรฐานคือทำ 3 ขั้น: เพิ่มแบบ optional → backfill ข้อมูลเดิม → ค่อยบังคับ required
  // ตอนนี้อยู่ขั้นที่ 1-2 (seed backfill ให้แล้ว) ขั้นที่ 3 อยู่ใน Backlog
  ownerId String? @unique
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  jobs Job[] // ความสัมพันธ์ 1-to-many: 1 บริษัท มีได้หลายงาน

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String

  location String
  workMode WorkMode @default(ONSITE)
  type     JobType  @default(FULL_TIME)

  // เก็บเงินเดือนเป็น Int (บาท/เดือน) และให้ null ได้ เพราะบางประกาศไม่ระบุ
  salaryMin Int?
  salaryMax Int?

  status      JobStatus @default(DRAFT)
  publishedAt DateTime?

  // ฝั่ง "many" ของความสัมพันธ์ — เก็บ foreign key ไว้ที่นี่
  // onDelete: Cascade = ถ้าบริษัทถูกลบ งานของบริษัทนั้นถูกลบตามอัตโนมัติโดย DB
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Index ตามรูปแบบ query ที่ใช้จริง: หน้า list กรอง status แล้วเรียงตาม publishedAt
  @@index([status, publishedAt])
  @@index([companyId])
}
